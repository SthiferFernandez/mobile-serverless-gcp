	"item": [
		{
			"name": "1. Health Check (K8s Pods Load Balance)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Tiempo de respuesta menor a 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});",
							"pm.test(\"Verificar motor y estudiante\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"OK\");",
							"    pm.expect(jsonData.engine).to.eql(\"Go + Fiber v2\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:30080/health",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "30080",
					"path": [
						"health"
					]
				},
				"description": "Endpoint de verificación de salud y balanceo entre los 5 pods del backend."
			},
			"response": []
		},
		{
			"name": "2. Login con PostgreSQL (Obtener JWT)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.environment.set(\"jwt_token\", jsonData.token);",
							"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"sthifer@test.com\",\n    \"password\": \"admin123\"\n}"
				},
				"url": {
					"raw": "http://localhost:30080/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "30080",
					"path": [
						"login"
					]
				},
				"description": "Autenticación contra PostgreSQL con bcrypt para generar token JWT."
			},
			"response": []
		},
		{
			"name": "3. Obtener Usuarios (Query a PostgreSQL)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Retorna lista de usuarios de PostgreSQL\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an(\"array\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
